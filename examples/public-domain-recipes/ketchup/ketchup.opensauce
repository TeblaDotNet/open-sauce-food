::ingredients

(tomato, sliced, medium-sized) 2 1/2 quart / 15-17 tomatoes
(garlic, large, chopped) 1 clove
(vinegar) 1 cup
(onion, chopped) 1/4 cup
(sugar) 1/2 cup
(cinnamon, stick) 3in piece
(salt) 1 1/4tsp
(paprika) 1tsp
(cloves, whole) 1tsp
(cayenne pepper) a dash

::equipment

(sieve)
(cloth, clean, thin, white)
(jar, hot, sterile)

::instructions

{tomato mixture} = (tomato) + (onion)
{tomato mixture} <simmer, 20-30m>
    <press, through sieve>
{spice bag} = (cinnamon) + (cloves) + (garlic)
{spice bag} <place, loosely in clean thin white cloth>
    <tie, top tightly>
{spiced vinegar} = (vinegar) + {spice bag}
{spiced vinegar} <simmer, 30m>
{spice bag} <remove>
{tomato mixture} <boil, rapidly, until half original amount, stir frequently against sticking>
{ketchup} = {tomato mixture} + {spiced vinegar} + (sugar) + (salt) + (paprika) + (cayenne pepper)
{ketchup} <boil, rapidly, constantly stirring, ~10m or until slightly thickened>
    <pour, hot sterile jars, fill to top>
    <seal>
