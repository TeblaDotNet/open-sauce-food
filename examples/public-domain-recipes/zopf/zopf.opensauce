::instructions

(butter) <cut, or tear>
{milk mix} = (butter) + (milk)
{milk mix} <heat, skillet, low, not above 31c>
{dough} = (flour) + (yeast) + (salt) + {milk mix}
{dough} <mix, large bowl>
    <knead, at least 15m, stretch a lot>
    <rest, warm spot, at least 1h, not above 31c>
(oven) <heat, 200c, start before braiding; source says no need to preheat>
{dough} <divide, two or three sections according to region>
    <stretch>
    <roll, long pieces>
    <braid>
    <place, parchment-lined baking sheet>
(egg) <beat>
{loaf} + (egg) <brush>
    <bake, 30m>
Repeat [
    {bread} <test, wooden skewer in widest part>
        <bake, another 5m if skewer not clean>
]
until skewer comes out clean
{bread} <cool, before cutting>

