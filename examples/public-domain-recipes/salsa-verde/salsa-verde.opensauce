    <simmer, ~10m, until tomatillos pale green>
{salsa} = (tomatillos) + (garlic) + (chillies choice) + (onion) + (cilantro)
{salsa} <transfer, blender or food processor>
    <purée, smooth>
    + (salt) <season, to taste, usually 1tsp / 6g>
(oil) <heat, medium saucepan, hot not smoking>
{salsa} <pour, into pan>
    <cook, 6-8m, stirring occasionally, until somewhat thickened>
    <refrigerate, leftovers>

::notes
