(tray)

::instructions

(oven) <heat, ~200c / 392f>
(eggplant) <slice, 1cm / 1/3in>
    <place, tray>
    + (olive oil) <coat, layer>
    <bake, 20m>
(onion) + (olive oil) <cook, medium, ~5-6m, until soft>
    + (garlic) + (garam masala) + (turmeric) + (coriander) <cook, 1-2m, release aroma>
{curry} = (onion) + (olive oil) + (garlic) + (garam masala) + (turmeric) + (coriander) + (tomato) + (coconut milk) + (eggplant) + (potato, chunks)
Optional [
    {curry} + (carrot) + (red pepper)
]
{curry} <cover>
    <simmer, ~15-20m>
(rice) <boil, 2 serves>
{curry} <uncover>
    <cook, further 5m or until reduced>
